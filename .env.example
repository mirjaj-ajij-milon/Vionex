# ==============================================================================
# VIONEX - ROOT ENVIRONMENT CONFIGURATION REFERENCE (.env.example)
# ==============================================================================
# This monorepo contains both the Backend and Frontend.
# Refer to this template when setting up environment variables locally or in cloud hosts.
#
# Backend files:  backend/.env.development  or  backend/.env.production
# Frontend files: frontend/.env.development or frontend/.env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ------------------------------------------------------------------------------

# Active Environment ('development' | 'production')
NODE_ENV=development

# Server Port (Render/Railway sets this automatically; 8080 for local)
PORT=8080

# Database Connection String
# Development: Local MongoDB instance
MONGO_URL=mongodb://127.0.0.1:27017/vionex
# Production: MongoDB Atlas Cluster Connection URI (with TLS enabled)
# MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/vionex?retryWrites=true&w=majority

# Client Origin (CORS Security)
# Development: Local Vite frontend port
CLIENT_ORIGIN=http://localhost:5173
# Production: Deployed frontend domain (e.g. Vercel or Netlify)
# CLIENT_ORIGIN=https://vionex.vercel.app

# Optional: STUN / TURN Server credentials for restrictive NATs / Firewalls
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=vionex_user
# TURN_CREDENTIAL=vionex_secret_password


# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ------------------------------------------------------------------------------

# Backend API server URL (consumed via import.meta.env.VITE_API_URL in React)
# Development: Local Express server
VITE_API_URL=http://localhost:8080
# Production: Deployed Backend URL (on Vercel or Render)
# VITE_API_URL=https://vionex-backend.vercel.app
