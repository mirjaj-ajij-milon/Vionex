# ==========================================
# VIONEX BACKEND - ENVIRONMENT CONFIG TEMPLATE
# ==========================================
# Copy to .env.development or .env.production as needed.
# For Vercel deployment: Set these in your Vercel Project Dashboard (Settings -> Environment Variables)

# Environment: 'development' or 'production'
NODE_ENV=development
PORT=8080

# Database Connection:
# Development (Local MongoDB): mongodb://127.0.0.1:27017/vionex
# Production (MongoDB Atlas):  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URL=mongodb://127.0.0.1:27017/vionex

# Allowed Client Origin (CORS):
# Development: http://localhost:5173
# Production:  https://vionex.vercel.app (or your production frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# Optional: TURN / STUN server for symmetric mobile NAT traversal
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
