# ==========================================
# Vionex Backend Environment Configuration
# Use for Local Development & Render Web Service
# ==========================================

NODE_ENV=production
PORT=10000
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/vionex?retryWrites=true&w=majority
CLIENT_ORIGIN=https://vionex.netlify.app

# Optional TURN Configuration (for strict corporate/symmetric NAT firewalls)
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-credential
