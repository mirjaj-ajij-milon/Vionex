# ==========================================
# Vionex Backend - Git Ignore Rules
# Strictly prevents secret leakage and build bloat
# ==========================================

# Environment & Secret files
.env
.env.*
.env*.local
*.env
*.local
**/.env
**/.env.*
**/.env*.local
**/*.env
**/*.local

# Whitelist template
!.env.example
!**/.env.example
!**/.env.*.example

# Dependencies
node_modules/
**/node_modules/

# Production build outputs & cache
dist/
dist-ssr/
build/
.cache/
.vercel/
**/.vercel/

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
